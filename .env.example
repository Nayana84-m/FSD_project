# ADMIN_EMAIL=admin@smartshift.local
# ADMIN_PASSWORD=replace_with_a_private_admin_password
# ADMIN_NAME=SmartShift Admin
# Optional only if the frontend is hosted separately from this API:
# CLIENT_ORIGIN=https://your-frontend.example
